{
  "name": "wedding-guest-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:pages --",
    "build": "npm run build:pages --",
    "preview": "npm run preview:pages --",
    "dev:pages": "vite --config vite.pages.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/garden.test.ts",
    "test:pages": "node --experimental-strip-types --test tests/pages*.test.ts",
    "test:pages:browser": "playwright test --config playwright.pages.config.ts",
    "photos:add": "node scripts/import-photos.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
